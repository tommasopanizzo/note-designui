# See https://help.github.com/articles/ignoring-files/

# --- Do NOT commit (local / secrets / build cache) ---
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js (rebuilt on Vercel)
/.next/
/out/

# production
/build

# env & hosting (secrets, local Vercel link)
.env*
.vercel

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# testing
/coverage

# typescript / tooling cache
*.tsbuildinfo
next-env.d.ts
.eslintcache

# OS & editors
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
.cursor/
AGENTS.md
CLAUDE.md

# --- MUST commit for the public registry (do not add above) ---
# public/r/*.json
# registry.json
# registry/default/
